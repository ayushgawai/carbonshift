# ============================================================================
# CARBONSHIFT - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this to .env and fill in your actual values

# -------------------------
# 1. GPU COMPUTE - NVIDIA Brev
# -------------------------
BREV_INSTANCE_ID=your_brev_instance_id
BREV_INSTANCE_NAME=your_instance_name
GPU_TYPE=A100_80GB
GPU_MEMORY_GB=80

# -------------------------
# 2. ENERGY/GRID APIS
# -------------------------
# WattTime (Primary - Real-time carbon intensity)
# Sign up: https://www.watttime.org/api-documentation/#register-new-user
WATTTIME_USERNAME=your_username_here
WATTTIME_PASSWORD=your_password_here
WATTTIME_REGION=CAISO_NORTH

# Electricity Maps (Backup)
# Sign up: https://api-portal.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=your_key_here

# Grid Configuration
GRID_REGION=CAISO_NORTH
TIMEZONE=America/Los_Angeles

# -------------------------
# 3. MODEL TRAINING
# -------------------------
# Hugging Face (Model downloads)
# Get token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=hf_your_token_here

# Training Workload Config
TRAINING_MODEL=resnet18
TRAINING_DATASET=cifar10

# -------------------------
# 4. LLM APIS (Orchestrator Intelligence)
# -------------------------
# OpenAI (Sponsor)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_key_here
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Sponsor)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# -------------------------
# 5. SPONSOR INTEGRATIONS
# -------------------------
# Fetch.ai (Autonomous Agents)
# Docs: https://fetch.ai/docs
FETCHAI_API_KEY=your_fetchai_key_here
FETCHAI_AGENT_ADDRESS=your_agent_address_here

# -------------------------
# 6. SYSTEM CONFIGURATION
# -------------------------
# Backend Server
API_HOST=0.0.0.0
API_PORT=8000

# Frontend CORS
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# -------------------------
# 7. ORCHESTRATOR SETTINGS (Eco-Pulse Arbitration)
# -------------------------
# Energy Thresholds
PRICE_THRESHOLD_CRITICAL=70.0    # USD/MWh - PAUSE training (RED state)
PRICE_THRESHOLD_HIGH=50.0        # USD/MWh - REDUCE power (AMBER state)
PRICE_THRESHOLD_LOW=35.0         # USD/MWh - BOOST power (GREEN state)

CARBON_THRESHOLD_CRITICAL=500    # gCO2/kWh - PAUSE (RED state)
CARBON_THRESHOLD_HIGH=400        # gCO2/kWh - REDUCE (AMBER state)
CARBON_THRESHOLD_LOW=300         # gCO2/kWh - BOOST (GREEN state)

# GPU Power Limits (Watts)
GPU_POWER_PAUSE=100              # RED state
GPU_POWER_REDUCE=150             # AMBER state
GPU_POWER_NORMAL=200             # NORMAL state
GPU_POWER_BOOST=250              # GREEN state

# Update Intervals
ENERGY_POLL_INTERVAL=60          # seconds - check grid every 60s
METRICS_BROADCAST_INTERVAL=2     # seconds - send to frontend every 2s

# -------------------------
# 8. COST CALCULATIONS
# -------------------------
AVG_OFFPEAK_PRICE=30.0          # USD/MWh
AVG_PEAK_PRICE=70.0             # USD/MWh
